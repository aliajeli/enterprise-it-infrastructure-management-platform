{
  "name": "enterprise-it-infrastructure-management-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Centralized enterprise IT infrastructure management platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @platform/web",
    "build": "npm run build --workspace @platform/web",
    "typecheck": "npm run typecheck --workspace @platform/web",
    "lint": "npm run lint --workspace @platform/web",
    "test": "npm run test --workspace @platform/web"
  }
}
